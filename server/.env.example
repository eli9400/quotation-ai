# Server runtime
PORT=4000
WEB_ORIGIN=http://localhost:5173
UPLOADS_DIR=./uploads
UPLOADS_MAX_MB=10
CLIENT_FORM_MAX_ITEMS=40

# Firebase Admin option A (recommended locally):
# copy firebase-service-account.example.json -> server/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Firebase Admin option B (direct env values):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Required for Firebase Storage operations (both options)
FIREBASE_STORAGE_BUCKET=

# Optional for Cloud Run / ADC flow
FIREBASE_USE_ADC=false

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Model retraining scheduler (Phase 7.1)
MODEL_RETRAIN_SCHEDULER_ENABLED=false
MODEL_RETRAIN_INTERVAL_MINUTES=360
MODEL_RETRAIN_MIN_EXAMPLES=50
MODEL_CANARY_TRAFFIC_PERCENT=10
MODEL_CANARY_MAX_MAE_INCREASE_PCT=0.15
MODEL_CANARY_MAX_SMAPE_INCREASE_PCT=0.2

# Model monitoring alerts
MODEL_ALERTS_ENABLED=true
MODEL_ALERT_MIN_ERROR_SAMPLES=20
MODEL_ALERT_MAX_MAE_INCREASE_PCT=0.35
MODEL_ALERT_MAX_SMAPE_INCREASE_PCT=0.35
